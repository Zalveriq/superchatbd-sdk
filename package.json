{
  "name": "@superchatbd/sdk",
  "version": "1.0.1",
  "description": "Official TypeScript / Node.js SDK for the Superchat BD Developer Platform: hosted checkout payments, refunds, account data and webhook signature verification.",
  "keywords": [
    "superchat",
    "superchatbd",
    "payments",
    "checkout",
    "webhooks",
    "hmac",
    "bdt",
    "bangladesh",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://superchatbd.com/docs/sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/zalveriq/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/zalveriq/sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check:package": "npm pack --dry-run",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
